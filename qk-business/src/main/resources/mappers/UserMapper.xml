<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.itheima.mapper.UserMapper">

    <select id="queryPageList" resultType="com.itheima.model.resp.UserResp">
        select
        u.*,
        d.name deptName,
        r.name roleName
        from user u
        left join dept d on u.dept_id = d.id
        left join role r on u.role_id = r.id
        <where>
            <if test="req.name != null and req.name != ''">
                u.name like concat('%', #{req.name}, '%')
            </if>
            <if test="req.phone != null and req.phone != ''">
                and u.phone = #{req.phone}
            </if>
            <if test="req.deptId != null">
                and u.dept_id = #{req.deptId}
            </if>
            <if test="req.status != null">
                and u.status = #{req.status}
            </if>
        </where>
        order by u.id desc
    </select>

    <select id="queryListByRoleLabel" resultType="com.itheima.model.dataobject.UserDO">
        select *
        from user u
                 left join role r on u.role_id = r.id
        where r.label = #{roleLabel}
    </select>
    <select id="queryListByDeptId" resultType="com.itheima.model.dataobject.UserDO">
        select *
        from user
        where dept_id = #{deptId}
    </select>
</mapper>
