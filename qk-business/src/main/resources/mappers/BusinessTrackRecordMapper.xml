<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.itheima.mapper.BusinessTrackRecordMapper">

    <!-- 某个商机的跟进记录，带出跟进人姓名 -->
    <select id="queryListByBusinessId" resultType="com.itheima.model.resp.BusinessTrackRecordResp">
        select
            btr.*,
            u.name as assignName
        from business_track_record btr
        left join user u on btr.user_id = u.id
        where btr.business_id = #{businessId}
        order by btr.id desc
    </select>

</mapper>
