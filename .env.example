# 轻客管家环境变量模板
# 用法：复制本文件为 .env（已被 .gitignore 忽略），按本机环境填写后，用 scripts/start-backend.ps1 启动，
#       或在 IDEA 的 Run Configuration → Environment variables 中逐条填写。
# 注意：不要把填写后的 .env 提交到仓库。

# ---- 后端服务 ----
QK_SERVER_PORT=8080

# ---- MySQL 数据库 ----
QK_DB_URL=jdbc:mysql://localhost:3306/qk
QK_DB_USERNAME=root
QK_DB_PASSWORD=

# ---- 阿里云 OSS（图片上传，不使用上传功能可留空） ----
QK_OSS_REGION=cn-beijing
QK_OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
QK_OSS_BUCKET=
QK_OSS_ACCESS_KEY_ID=
QK_OSS_ACCESS_KEY_SECRET=

# ---- JWT ----
# 生产环境请替换为足够长的高强度随机串
QK_JWT_SECRET_KEY=please-change-me-to-a-long-random-string
QK_JWT_EXPIRATION_TIME=86400000

# ---- 代码生成脚手架（可选） ----
QK_GEN_OUTPUT_DIR=target/generated-code

# ---- 前端（可选，scripts/start-frontend.ps1 使用） ----
QK_NGINX_DIR=
